# Copy to keystore.properties (which is gitignored) and fill in.
#
# This file is read by app/build.gradle to sign the release bundle. Nothing
# here belongs in git: the passwords are in plain text, and the keystore they
# unlock is the only proof to Google that an update came from you.
#
# Create the keystore once, and never again:
#
#   keytool -genkeypair -v \
#     -keystore ~/keys/alphabet-match-upload.jks \
#     -alias alphabet-match \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storetype PKCS12
#
# Keep it outside the repo (~/keys is a fine home) and back it up somewhere
# that survives this laptop. With Play App Signing, Google holds the key that
# actually signs what users install and this one is only the *upload* key, so
# losing it means asking Google to reset it rather than abandoning the listing
# — but that is a support ticket, not a five-minute fix.

storeFile=/Users/you/keys/alphabet-match-upload.jks
storePassword=
keyAlias=alphabet-match
keyPassword=
