# Playwright MCP scratch: page snapshots and console logs from browser runs.
.playwright-mcp/

# Node tooling for the native shell. The game itself still has no build step —
# npm is here only to drive Capacitor.
node_modules/

# Generated by `npm run build`: a clean mirror of the shippable files, which is
# what Capacitor copies into the native projects. Never edit anything in here;
# edit index.html / voice-player.js / voice/ at the repo root instead.
www/

# ios/ and android/ ARE committed — they are editable native projects, not build
# output. Each carries its own .gitignore for the artifacts within.
