# Playwright MCP scratch: page snapshots and console logs from browser runs.
.playwright-mcp/

# Node tooling for the native shell. The game itself still has no build step —
# npm is here only to drive Capacitor.
node_modules/

# Generated by `npm run build`: a clean mirror of the shippable files, which is
# what Capacitor copies into the native projects. Never edit anything in here;
# edit index.html / voice-player.js / voice/ at the repo root instead.
www/

# Intermediates that `npm run artwork` renders out of assets/source.html on its
# way to the platform files. The page is the source and is committed; these are
# handed straight to @capacitor/assets and are of no use on their own. The icons
# and splashes it cuts under ios/ and android/ are committed, so a clone that
# never runs the script still builds a properly badged app.
assets/*.png

# @capacitor/assets insists on emitting a PWA icon set; nothing here is a PWA.
icons/

# Store screenshots, rebuilt by `npm run screenshots` in a few seconds. They are
# upload fodder for App Store Connect and Play Console — nothing in the repo
# builds from them, and they would only go stale in here.
store/

# ios/ and android/ ARE committed — they are editable native projects, not build
# output. Each carries its own .gitignore for the artifacts within.
